# Copie para .env e troque os valores.
POSTGRES_DB=educamobile
POSTGRES_USER=educamobile
# Use só letras, números, - ou _: a senha entra na URL de conexão sem ser codificada.
POSTGRES_PASSWORD=troque-esta-senha
DB_PORT=5433
# Usada ao rodar a API ou os testes fora do Docker.
DATABASE_URL=postgresql+psycopg://educamobile:troque-esta-senha@localhost:5433/educamobile
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
CORS_ORIGINS=["http://localhost:5173","http://localhost:5500"]
